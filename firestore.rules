rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Friendships are stored once per pair, under the two IDs in sorted order.
    function pairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    function isFriend(uid) {
      return signedIn()
        && exists(/databases/$(database)/documents/friendships/$(pairId(request.auth.uid, uid)));
    }

    function isUsername(name) {
      return name is string && name.matches('^[a-z0-9_]{3,20}$');
    }

    function intIn(v, lo, hi) {
      return v is int && v >= lo && v <= hi;
    }

    // Private records: tasks, habits, logs, sessions, templates and the private profile
    // (users/{uid} itself, which holds the username and sharing choices).
    match /users/{uid}/{document=**} {
      allow read, write: if isMe(uid);
    }

    // One document per taken name, so names are unique. Created only if free, never
    // reassigned, and released by deleting it.
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if isMe(request.resource.data.uid)
        && isUsername(name)
        && request.resource.data.keys().hasOnly(['uid']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // The public card search needs: name, display name, level and an optional photo. Its
    // username must be one this user holds, checked after the write so claiming and setting
    // can share a batch.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['username', 'displayName', 'level', 'photo', 'updatedAt'])
        && validPhoto(request.resource.data)
        && isUsername(request.resource.data.username)
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 40
        && intIn(request.resource.data.level, 1, 1000)
        && request.resource.data.updatedAt is string;
      allow delete: if isMe(uid);
    }

    // Numbers friends see. Written only by the owner, with limits a real week can't exceed.
    match /stats/{uid} {
      allow read: if isMe(uid) || isFriend(uid);
      allow create, update: if isMe(uid) && validStats(request.resource.data);
      allow delete: if isMe(uid);
    }

    // A pending request from `from` to `to`; accepting one is the only way to become friends.
    function hasPendingRequest(from, to) {
      let path = /databases/$(database)/documents/friendRequests/$(from + '_' + to);
      return exists(path) && get(path).data.status == 'pending';
    }

    function otherMember(members) {
      return members[0] == request.auth.uid ? members[1] : members[0];
    }

    match /friendRequests/{id} {
      allow read: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'to', 'fromUsername', 'fromName', 'toUsername', 'status', 'createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.to
        && request.resource.data.status == 'pending'
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.to))
        && !exists(/databases/$(database)/documents/friendships/$(pairId(request.auth.uid, request.resource.data.to)));
      // The recipient can decline; either side can withdraw or clear it.
      allow update: if signedIn()
        && resource.data.to == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'declined';
      allow delete: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    match /friendships/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'since'])
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] < request.resource.data.members[1]
        && id == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && hasPendingRequest(otherMember(request.resource.data.members), request.auth.uid);
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
    }

    // Completed shared tasks and habits, badges and level-ups. Friends can read them; only
    // the owner writes, under IDs that start with their own uid.
    match /activity/{id} {
      allow read: if signedIn()
        && (resource.data.uid == request.auth.uid || isFriend(resource.data.uid));
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'kind', 'title', 'at'])
        && request.resource.data.uid == request.auth.uid
        && id.matches(request.auth.uid + '_.+')
        && request.resource.data.kind in ['task', 'habit', 'badge', 'level']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.at is string;
      // Deleting an item that was never posted is allowed under your own prefix, so undoing a
      // shared task or habit never fails just because nothing was posted for it.
      allow delete: if signedIn()
        && (resource == null ? id.matches(request.auth.uid + '_.+') : resource.data.uid == request.auth.uid);
    }

    // One reaction per person per activity item, from a friend of its owner. The owner and
    // their friends can read them; the cheerer can change or take theirs back, and the owner
    // can clear any on their own items.
    function validCheer(c, id) {
      return c.keys().hasOnly(['activityId', 'owner', 'uid', 'emoji', 'at'])
        && c.uid == request.auth.uid
        && id == c.activityId + '_' + request.auth.uid
        && c.emoji in ['👏', '🔥', '💪', '🎉']
        && c.at is string
        && c.owner != request.auth.uid
        && isFriend(c.owner)
        && exists(/databases/$(database)/documents/activity/$(c.activityId))
        && get(/databases/$(database)/documents/activity/$(c.activityId)).data.uid == c.owner;
    }

    match /cheers/{id} {
      allow read: if signedIn()
        && (resource.data.owner == request.auth.uid || resource.data.uid == request.auth.uid
          || isFriend(resource.data.owner));
      allow create: if signedIn() && validCheer(request.resource.data, id);
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && validCheer(request.resource.data, id);
      allow delete: if signedIn()
        && (resource.data.uid == request.auth.uid || resource.data.owner == request.auth.uid);
    }

    // The next 48 hours of reminders for one person, and their devices' push tokens. Only
    // the owner reads or writes it; the scheduled sender reads it with admin access.
    match /pushPlans/{uid} {
      allow read, delete: if isMe(uid);
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['tokens', 'slots', 'items', 'tz', 'updatedAt'])
        && (!('tokens' in request.resource.data)
          || (request.resource.data.tokens is list && request.resource.data.tokens.size() <= 10))
        && (!('slots' in request.resource.data)
          || (request.resource.data.slots is list && request.resource.data.slots.size() <= 120))
        && (!('items' in request.resource.data) || request.resource.data.items is map)
        && (!('tz' in request.resource.data) || (request.resource.data.tz is string && request.resource.data.tz.size() <= 64))
        && request.resource.data.updatedAt is string;
    }

    // ---- Groups ----

    function groupPath(gid) {
      return /databases/$(database)/documents/groups/$(gid);
    }

    function isMember(gid) {
      return signedIn() && exists(/databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid));
    }

    function validGroup(g) {
      return g.name is string && g.name.size() > 0 && g.name.size() <= 40
        && g.code is string && g.code.matches('^[A-HJ-NP-Z2-9]{6}$')
        && intIn(g.targetMinutes, 0, 100000);
    }

    // A member's copy of their own weekly numbers, so the group can rank them.
    function validMember(m, uid) {
      return m.keys().hasOnly([
          'uid', 'displayName', 'username', 'code', 'joinedAt', 'level', 'weekKey', 'weekXp',
          'weekFocusMinutes', 'seasonKey', 'seasonXp', 'streak', 'updatedAt'])
        && m.uid == uid
        && m.displayName is string && m.displayName.size() <= 40
        && isUsername(m.username)
        && intIn(m.level, 1, 1000)
        && m.weekKey is string && m.weekKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && intIn(m.weekXp, 0, 20000)
        && intIn(m.weekFocusMinutes, 0, 10080)
        && m.seasonKey is string && m.seasonKey.matches('^[0-9]{4}-[0-9]{2}$')
        && intIn(m.seasonXp, 0, 80000)
        && intIn(m.streak, 0, 100000);
    }

    match /groups/{gid} {
      allow read: if isMember(gid);
      // Created together with its invite code and the owner's own membership.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'ownerUid', 'code', 'targetMinutes', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && validGroup(request.resource.data)
        && getAfter(/databases/$(database)/documents/groupCodes/$(request.resource.data.code)).data.groupId == gid;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'targetMinutes'])
        && validGroup(request.resource.data);
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /members/{uid} {
        allow read: if isMember(gid);
        // Knowing the group's invite code is what lets you join.
        allow create: if isMe(uid)
          && validMember(request.resource.data, uid)
          && request.resource.data.code == getAfter(groupPath(gid)).data.code;
        allow update: if isMe(uid)
          && validMember(request.resource.data, uid)
          && request.resource.data.code == resource.data.code;
        // Leave, or be removed by the owner.
        allow delete: if isMe(uid) || (signedIn() && get(groupPath(gid)).data.ownerUid == request.auth.uid);
      }
    }

    // Invite codes point to a group and show its name before joining. Fetched one at a
    // time by code; they can't be listed.
    match /groupCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['groupId', 'name'])
        && getAfter(groupPath(request.resource.data.groupId)).data.ownerUid == request.auth.uid
        && getAfter(groupPath(request.resource.data.groupId)).data.code == code;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && get(groupPath(resource.data.groupId)).data.ownerUid == request.auth.uid;
      allow delete: if signedIn() && get(groupPath(resource.data.groupId)).data.ownerUid == request.auth.uid;
    }

    // ---- Focus rooms ----

    function roomPath(rid) {
      return /databases/$(database)/documents/rooms/$(rid);
    }

    function inRoom(rid) {
      return signedIn() && exists(/databases/$(database)/documents/rooms/$(rid)/members/$(request.auth.uid));
    }

    function validSession(s) {
      return s == null || (s is map
        && s.keys().hasOnly(['startedAt', 'endsAt', 'minutes'])
        && s.startedAt is string && s.endsAt is string
        && intIn(s.minutes, 1, 240));
    }

    function validRoom(r) {
      return r.name is string && r.name.size() > 0 && r.name.size() <= 40
        && r.code is string && r.code.matches('^[A-HJ-NP-Z2-9]{6}$')
        && intIn(r.goalMinutes, 0, 100000)
        && validSession(r.session);
    }

    // Names and states only: what someone is working on is never stored here.
    function validRoomMember(m, uid) {
      return m.keys().hasOnly(['uid', 'displayName', 'username', 'code', 'joinedAt', 'state', 'heartbeatAt', 'minutes'])
        && m.uid == uid
        && m.displayName is string && m.displayName.size() <= 40
        && isUsername(m.username)
        && m.state in ['idle', 'focusing', 'break']
        && m.heartbeatAt is string
        && intIn(m.minutes, 0, 1000000);
    }

    match /rooms/{rid} {
      allow read: if inRoom(rid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'hostUid', 'code', 'goalMinutes', 'session', 'createdAt'])
        && request.resource.data.hostUid == request.auth.uid
        && validRoom(request.resource.data)
        && getAfter(/databases/$(database)/documents/roomCodes/$(request.resource.data.code)).data.roomId == rid;
      // Only the host renames, sets the goal, or starts and ends the shared session.
      allow update: if signedIn()
        && resource.data.hostUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'goalMinutes', 'session'])
        && validRoom(request.resource.data);
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;

      match /members/{uid} {
        allow read: if inRoom(rid);
        allow create: if isMe(uid)
          && validRoomMember(request.resource.data, uid)
          && request.resource.data.minutes == 0
          && request.resource.data.code == getAfter(roomPath(rid)).data.code;
        // Your own state and heartbeat; focus minutes only go up, by at most one session.
        allow update: if isMe(uid)
          && validRoomMember(request.resource.data, uid)
          && request.resource.data.code == resource.data.code
          && request.resource.data.minutes >= resource.data.minutes
          && request.resource.data.minutes <= resource.data.minutes + 240;
        allow delete: if isMe(uid) || (signedIn() && get(roomPath(rid)).data.hostUid == request.auth.uid);
      }
    }

    match /roomCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['roomId', 'name'])
        && getAfter(roomPath(request.resource.data.roomId)).data.hostUid == request.auth.uid
        && getAfter(roomPath(request.resource.data.roomId)).data.code == code;
      allow delete: if signedIn() && get(roomPath(resource.data.roomId)).data.hostUid == request.auth.uid;
    }

    // No photo, or a small picture shrunk on the device, or a Google account photo link.
    function validPhoto(d) {
      return !('photo' in d) || d.photo == ''
        || (d.photo is string && d.photo.size() <= 20000
          && (d.photo.matches('^data:image/(webp|jpeg);base64,[A-Za-z0-9+/=]+$')
            || d.photo.matches('^https://lh3[.]googleusercontent[.]com/[^ "<>]+$')));
    }

    // A real day holds at most 1,440 minutes of focus.
    function validWeek(w) {
      return w is list && w.size() == 7
        && intIn(w[0], 0, 1440) && intIn(w[1], 0, 1440) && intIn(w[2], 0, 1440)
        && intIn(w[3], 0, 1440) && intIn(w[4], 0, 1440) && intIn(w[5], 0, 1440)
        && intIn(w[6], 0, 1440);
    }

    // The bio, pinned badges and per-day focus are optional, so older app versions that
    // don't send them still pass.
    function validStats(s) {
      return s.keys().hasOnly([
          'level', 'xp', 'badges', 'weekKey', 'weekXp', 'weekFocusMinutes', 'weekFocusByDay',
          'seasonKey', 'seasonXp', 'streak', 'focusing', 'bio', 'pinned', 'updatedAt'])
        && (!('weekFocusByDay' in s) || validWeek(s.weekFocusByDay))
        && (!('bio' in s) || (s.bio is string && s.bio.size() <= 80))
        && (!('pinned' in s) || (s.pinned is list && s.pinned.size() <= 3))
        && intIn(s.level, 1, 1000)
        && intIn(s.xp, 0, 10000000)
        && s.badges is list && s.badges.size() <= 60
        && s.weekKey is string && s.weekKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && intIn(s.weekXp, 0, 20000)
        && intIn(s.weekFocusMinutes, 0, 10080)
        && s.seasonKey is string && s.seasonKey.matches('^[0-9]{4}-[0-9]{2}$')
        && intIn(s.seasonXp, 0, 80000)
        && intIn(s.streak, 0, 100000)
        && (s.focusing == null || (s.focusing is map && s.focusing.keys().hasOnly(['until', 'roomId'])))
        && s.updatedAt is string;
    }
  }
}
