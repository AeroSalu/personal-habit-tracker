rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Friendships are stored once per pair, under the two IDs in sorted order.
    function pairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    function isFriend(uid) {
      return signedIn()
        && exists(/databases/$(database)/documents/friendships/$(pairId(request.auth.uid, uid)));
    }

    function isUsername(name) {
      return name is string && name.matches('^[a-z0-9_]{3,20}$');
    }

    function intIn(v, lo, hi) {
      return v is int && v >= lo && v <= hi;
    }

    // Private records: tasks, habits, logs, sessions, templates and the private profile
    // (users/{uid} itself, which holds the username and sharing choices).
    match /users/{uid}/{document=**} {
      allow read, write: if isMe(uid);
    }

    // One document per taken name, so names are unique. Created only if free, never
    // reassigned, and released by deleting it.
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if isMe(request.resource.data.uid)
        && isUsername(name)
        && request.resource.data.keys().hasOnly(['uid']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // The public card search needs: name, display name and level. Its username must be
    // one this user holds, checked after the write so claiming and setting can share a batch.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['username', 'displayName', 'level', 'updatedAt'])
        && isUsername(request.resource.data.username)
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 40
        && intIn(request.resource.data.level, 1, 1000)
        && request.resource.data.updatedAt is string;
      allow delete: if isMe(uid);
    }

    // Numbers friends see. Written only by the owner, with limits a real week can't exceed.
    match /stats/{uid} {
      allow read: if isMe(uid) || isFriend(uid);
      allow create, update: if isMe(uid) && validStats(request.resource.data);
      allow delete: if isMe(uid);
    }

    // A pending request from `from` to `to`; accepting one is the only way to become friends.
    function hasPendingRequest(from, to) {
      let path = /databases/$(database)/documents/friendRequests/$(from + '_' + to);
      return exists(path) && get(path).data.status == 'pending';
    }

    function otherMember(members) {
      return members[0] == request.auth.uid ? members[1] : members[0];
    }

    match /friendRequests/{id} {
      allow read: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'to', 'fromUsername', 'fromName', 'toUsername', 'status', 'createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.to
        && request.resource.data.status == 'pending'
        && exists(/databases/$(database)/documents/profiles/$(request.resource.data.to))
        && !exists(/databases/$(database)/documents/friendships/$(pairId(request.auth.uid, request.resource.data.to)));
      // The recipient can decline; either side can withdraw or clear it.
      allow update: if signedIn()
        && resource.data.to == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'declined';
      allow delete: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    match /friendships/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'since'])
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] < request.resource.data.members[1]
        && id == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && hasPendingRequest(otherMember(request.resource.data.members), request.auth.uid);
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
    }

    // Completed shared tasks and habits, badges and level-ups. Friends can read them; only
    // the owner writes, under IDs that start with their own uid.
    match /activity/{id} {
      allow read: if signedIn()
        && (resource.data.uid == request.auth.uid || isFriend(resource.data.uid));
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'kind', 'title', 'at'])
        && request.resource.data.uid == request.auth.uid
        && id.matches(request.auth.uid + '_.+')
        && request.resource.data.kind in ['task', 'habit', 'badge', 'level']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.at is string;
      // Deleting an item that was never posted is allowed under your own prefix, so undoing a
      // shared task or habit never fails just because nothing was posted for it.
      allow delete: if signedIn()
        && (resource == null ? id.matches(request.auth.uid + '_.+') : resource.data.uid == request.auth.uid);
    }

    function validStats(s) {
      return s.keys().hasOnly([
          'level', 'xp', 'badges', 'weekKey', 'weekXp', 'weekFocusMinutes',
          'seasonKey', 'seasonXp', 'streak', 'focusing', 'updatedAt'])
        && intIn(s.level, 1, 1000)
        && intIn(s.xp, 0, 10000000)
        && s.badges is list && s.badges.size() <= 60
        && s.weekKey is string && s.weekKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && intIn(s.weekXp, 0, 20000)
        && intIn(s.weekFocusMinutes, 0, 10080)
        && s.seasonKey is string && s.seasonKey.matches('^[0-9]{4}-[0-9]{2}$')
        && intIn(s.seasonXp, 0, 80000)
        && intIn(s.streak, 0, 100000)
        && (s.focusing == null || (s.focusing is map && s.focusing.keys().hasOnly(['until', 'roomId'])))
        && s.updatedAt is string;
    }
  }
}
